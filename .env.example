TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Optional: Android App Links signing-certificate SHA-256 fingerprints served in
# /.well-known/assetlinks.json. Comma-separated for multiple keys (release, QA, ...).
# Each must be 32 uppercase hex pairs separated by colons; invalid entries are logged and ignored.
# Defaults to the debug key when unset:
# B8:B8:DF:5E:F6:D8:88:4C:AE:43:AD:93:94:6C:FC:A2:DF:B3:AA:85:1A:30:EE:B6:18:22:0C:B0:49:F8:AD:6E
# ANDROID_SHA256_CERT_FINGERPRINTS=

# Optional: absolute http(s) URL for the "Get the app" button on /movie/:id pages.
# The button is hidden when unset. Any other value stops the server at startup.
# APP_STORE_URL=
